<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App -->
    <string name="app_name">Reels Blocker</string>

    <!-- Accessibility Service -->
    <string name="accessibility_service_label">Reels Blocker Service</string>
    <string name="accessibility_service_description">
        Monitors Instagram to block Reels in the main feed and prevent
        swiping between Reels opened from profiles or direct messages.
    </string>

    <!-- Device Admin -->
    <string name="device_admin_label">Reels Blocker Admin</string>
    <string name="device_admin_explanation">
        Activating Device Administrator makes it harder to accidentally
        uninstall this focus tool. No sensitive policies are applied.
    </string>
    <string name="device_admin_enabled_msg">Reels Blocker is now protected ✓</string>
    <string name="device_admin_disabled_msg">Reels Blocker protection removed.</string>
    <string name="device_admin_disable_warning">
        Deactivating admin protection means Reels Blocker can be uninstalled
        without this confirmation step. Are you sure?
    </string>

    <!-- Notification -->
    <string name="notification_channel_name">Reels Blocker Status</string>
    <string name="notification_channel_desc">Shows when the Reels blocker is active.</string>
    <string name="notification_title">Feed Reels Blocker Active</string>
    <string name="notification_text">Blocking Reels in the home feed · swipe blocked in player</string>

    <!-- Status card -->
    <string name="status_icon_desc">Current status icon</string>
    <string name="status_fully_active">Fully Active</string>
    <string name="status_fully_active_sub">All protections are enabled.\nReels blocking is running.</string>
    <string name="status_partially_active">Partially Active</string>
    <string name="status_partially_active_sub">Core blocking is on, but some optional\nprotections are missing.</string>
    <string name="status_inactive">Inactive</string>
    <string name="status_inactive_sub">Enable the Accessibility Service\nbelow to start blocking.</string>

    <!-- Section label -->
    <string name="section_permissions">Permissions &amp; Services</string>

    <!-- Permission rows — titles and descriptions -->
    <string name="perm_accessibility_title">Accessibility Service</string>
    <string name="perm_accessibility_desc">Required — detects and blocks Reels interactions.</string>

    <string name="perm_admin_title">Device Administrator</string>
    <string name="perm_admin_desc">Recommended — prevents accidental uninstall.</string>

    <string name="perm_battery_title">Battery Optimization</string>
    <string name="perm_battery_desc">Recommended — prevents the OS from killing the service.</string>

    <string name="perm_service_title">Foreground Service</string>
    <string name="perm_service_desc">Required — keeps the blocker running in the background.</string>

    <!-- Button labels -->
    <string name="btn_grant">Grant</string>
    <string name="btn_activate">Activate</string>
    <string name="btn_exclude">Exclude</string>
    <string name="btn_start">Start</string>
    <string name="btn_open_settings">Open Settings</string>

    <!-- Row state labels (shown when already active) -->
    <string name="status_granted">Granted ✓</string>
    <string name="status_active">Active ✓</string>
    <string name="status_excluded">Excluded ✓</string>
    <string name="status_running">Running ✓</string>

    <!-- Dialogs -->
    <string name="dialog_accessibility_title">Enable Accessibility Service</string>
    <string name="dialog_accessibility_message">
        In the next screen:\n\n
        1. Tap \"Downloaded apps\" or \"Installed apps\"\n
        2. Select \"Reels Blocker Service\"\n
        3. Toggle it ON\n
        4. Tap OK on the confirmation dialog\n\n
        Then return to this app.
    </string>

    <!-- Footer -->
    <string name="footer_note">No data is collected or shared.\nAll processing happens on-device.</string>
</resources>
